# Copy the values you need into your shell or a local .env (never commit real secrets).

# Backend
LABPULSE_DATABASE_URL=sqlite:///./labpulse.db
# Set to true when the app is served over HTTPS.
LABPULSE_COOKIE_SECURE=false
LABPULSE_SESSION_DAYS=14
# AI summary of the Meeting Brief: off unless a key is set. Put the real key in your shell, never in a file in the repo.
# ANTHROPIC_API_KEY=
# LABPULSE_AI_MODEL=claude-haiku-5-5

# Frontend dev server
LABPULSE_API_URL=http://127.0.0.1:8000
LABPULSE_WEB_PORT=5173
